      else score+=x.cards.length*14;
    }
    // 控制牌保留（通用）：A/2/王 单/对 没清空手牌先出 → 重罚（所有角色），压过"出大牌后结构好"的诱因
    if(after.length>0&&pattern.main>=14&&(pattern.type==='SINGLE'||pattern.type==='PAIR')&&pattern.type!=='BOMB'&&pattern.type!=='ROCKET')score-=25;
    // 带牌更优：三带一/三带二比裸三张多走牌（三带二带对子走5张最优）
    if(pattern.type==='TRIPLE_ONE')score+=8;
    if(pattern.type==='TRIPLE_TWO')score+=12;
    // 带牌不带大牌：三带/飞机配件含 2/王（非清空手牌）→ 额外重罚（收尾前绝不把2/王当配件带走）
    if(after.length>0&&(pattern.type==='TRIPLE_ONE'||pattern.type==='TRIPLE_TWO'||pattern.type==='AIRPLANE_SINGLE'||pattern.type==='AIRPLANE_PAIR')){
      const mainCnt=x.cards.filter(c=>c.rank===pattern.main).length;
      const kickerBig=x.cards.some(c=>c.rank>=15&&!(c.rank===pattern.main&&mainCnt>=3));
      if(kickerBig)score-=40;
    }
    // 大牌型整合奖励：只给小组合——连对最高点≤11(到J)先出（小连对 334455 该出就出）；
    // 含 Q/K/A 的大连对不先出（大对子留后期控场），含 A 的顺子不优先（A 留后期抢牌权）
    if(pattern.type==='STRAIGHT_PAIR'&&pattern.len>=5&&pattern.main+pattern.len-1<=11)score+=50;
    else if(pattern.type==='STRAIGHT_PAIR'&&pattern.len>=3&&pattern.main+pattern.len-1<=11)score+=25;
    else if(pattern.type==='STRAIGHT_PAIR'&&pattern.main+pattern.len-1>=12)score-=15;
    if(pattern.type==='STRAIGHT'&&pattern.len>=5&&pattern.main+pattern.len-1<=13)score+=40;
    else if(pattern.type==='STRAIGHT'&&pattern.main+pattern.len-1>=14)score-=10;
    if(pattern.type==='AIRPLANE')score+=45;
    // 飞机带翅膀走更多张，更优：带对翅膀(333444+88+99) 比裸飞机多走 len*2 张 → 额外加分
    if(pattern.type==='AIRPLANE_PAIR')score+=45;
    else if(pattern.type==='AIRPLANE_SINGLE')score+=25;
    // 回收能力：出完这手后，手里还有没有能压回这个牌型的牌（同牌型更大，或炸弹/王炸兜底）。
    // 能接回 → 保持牌权；接不回来（如甩唯一对子）→ 牌权易手，除非迫不得已或能直接赢
    if(after.length>0&&pattern.type!=='BOMB'&&pattern.type!=='ROCKET'){
      const recover=aiCandidates(after).some(c=>
        (c.pattern.type===pattern.type&&c.pattern.len===pattern.len&&c.pattern.main>pattern.main)||
        c.pattern.type==='BOMB'||c.pattern.type==='ROCKET');
      if(recover)score+=8;else score-=12;
    }
    // 升级点四：送牌三原则 + 防送地主（队友快出完时正确送队友走）
    if(role!=='landlord'&&partner>=0&&partnerCount<=2&&partner===aiNext(who)){
      // ① 位置✅（队友是自己的下家，相邻安全，中间无地主）
      // ② 牌型匹配：队友剩1张只送单张，剩2张送单张或对子
      // ③ 队友快出完时，绝不能拿控制牌(2/王)单出当送牌/甩控制牌——重罚（压过"清散牌+完美结构"的诱因）
      if((pattern.type==='SINGLE'||pattern.type==='PAIR')&&pattern.main>=15)score-=70;
      const sendOk=(partnerCount===1&&pattern.type==='SINGLE')||(partnerCount===2&&(pattern.type==='SINGLE'||pattern.type==='PAIR'));
      if(sendOk){
        const sendSplit=aiSplitPenalty(x.cards,freq);
        const maxSendRank=Math.max(...x.cards.map(c=>c.rank));
        // ③ 代价：不拆大结构（最多拆一个散对）、不送控制牌(A/2/王)
        let sendGood=sendSplit<8&&maxSendRank<14&&after.length>0;
        // 防送地主：地主也快出完(≤2张)时，送单张风险极大（地主几乎总能截胡接走、直接赢）→ 不送单张
        if(sendGood&&landlordCount<=2&&pattern.type==='SINGLE')sendGood=false;
        if(sendGood){
          if(pattern.type==='SINGLE')score+=40;
          else if(pattern.type==='PAIR')score+=30;
        }
      }
    }else if(role!=='landlord'&&partnerCount>=3&&partnerCount<=5&&partnerCount<hand.length){
      // 队友牌还多(3~5张)：温和倾向出小牌，方便后续配合（队友≤2张时只走严格送牌，不在此）
      if(pattern.type==='SINGLE'&&pattern.main<=6)score+=34;
      if(pattern.type==='PAIR'&&pattern.main<=8)score+=20;
    }
    if(role!=='landlord'&&landlordCount<=5&&(pattern.type==='BOMB'||pattern.type==='ROCKET'))score+=24;
    if(role==='landlord'&&pattern.type!=='SINGLE')score+=10;
    // 升级点六：地主 AI 专属策略（电脑当地主也要聪明）
    if(role==='landlord'){
      // ① 中前期(手牌>8)探路：出小单张(≤7)试探农民；甩大牌单/对重罚（保留控制牌）
      if(hand.length>8){
        if(pattern.type==='SINGLE'&&pattern.main<=7)score+=24;
        if((pattern.type==='SINGLE'||pattern.type==='PAIR')&&pattern.main>=14)score-=20;
      }
      // ② 手牌多(>10)不轻易拆结构：拆对子/三张/炸弹再加重
      if(hand.length>10&&aiSplitPenalty(x.cards,freq)>0)score-=10;
      // ③ 剩≤5张快速收尾：能多走牌就多走
      if(hand.length<=5&&after.length>0)score+=x.cards.length*8;
      // ④ 残局剩2张：若手里是对子且农民最少剩牌≤2 → 出对子更安全（农民难接对子）
      if(hand.length===2&&pattern.type==='PAIR'){
        const minFarm=Math.min(G.hands[LEFT].length,G.hands[RIGHT].length);
        if(minFarm<=2)score+=25;
      }
    }
    // ===== 基本排序（正常人思维第一层）：单/对/三带按"小牌优先"给基础分，机制上保证先小后大 =====
    if(pattern.type!=='BOMB'&&pattern.type!=='ROCKET')score+=(14-pattern.main)*2;
    // ===== 位置修正（第二层）=====
    if(role==='farmerPrev'){
      // 上家领出：下一个是地主 → 中牌(7~J)从小到大先出（防地主过小牌、又不浪费控制牌）
      if(pattern.type==='SINGLE'){
        if(pattern.main>=7&&pattern.main<=11)score+=21-3*(pattern.main-7); // 7→+21,8→+18,9→+15,10→+12,J→+9（梯度递减=从小到大）
        if(pattern.main<=6)score-=8;      // 小单会送地主过牌 → 轻减
        if(pattern.main>=12)score-=18;    // Q/A/2/王 控制牌 → 重减（留后期控场）
        if(landlordCount<=2&&pattern.main>=13)score+=25; // 地主快出完：必须用大牌顶
      }
      if(pattern.type==='PAIR'){
        if(pattern.main>=7&&pattern.main<=11)score+=18-3*(pattern.main-7); // 对7→+18...对J→+6（从小到大）
        if(pattern.main<=6)score-=8;
        if(pattern.main>=12)score-=15;    // 对Q/对K/对A 留后期
        if(landlordCount<=2&&pattern.main>=13)score+=20;
      }
      if(hand.length<=3)score+=30;
    }
    if(role==='farmerNext'){
      // 下家领出：下一个是队友 → 小牌优先（先小后大，队友能接），大牌保留；地主快出完时中牌顶
      if(pattern.type==='SINGLE'){
        if(pattern.main>=14)score-=15;    // A/2/王 控制牌保留
        if(landlordCount<=2&&pattern.main>=8&&pattern.main<=14)score+=20; // 地主快出完：中牌顶
      }
      if(pattern.type==='PAIR'){
        if(pattern.main>=14)score-=12;    // 对A/对2 保留
        if(landlordCount<=2&&pattern.main>=8)score+=15;
      }
      if(hand.length<=3)score+=30;
    }
    const strat=String(mode||'').replace('lead-','');
    if(strat==='aggressive'){
      if(after.length<=2)score+=18;
      else if(hand.length<=5)score+=x.cards.length*6;
    }else if(strat==='support'){
      if(partnerCount<=4){
        if(pattern.type==='SINGLE'&&pattern.main<=7)score+=22;
        if(pattern.type==='PAIR'&&pattern.main<=9)score+=16;
      }
      if(pattern.type==='BOMB'||pattern.type==='ROCKET')score-=15;
    }else if(strat==='defensive'){
      const maxCardRank=Math.max(...x.cards.map(c=>c.rank));
      if(after.length>2&&maxCardRank>=14&&pattern.type!=='BOMB'&&pattern.type!=='ROCKET')score-=12;
    }
  }
  return score;
}

function aiShouldPassCounter(hand,last,who,candidates){
  const role=aiRole(who),partner=aiPartner(who),lp=lastPlayerForAI(),landlordCount=aiLandlordCount(),partnerCount=partner>=0?(G.hands[partner]||[]).length:99;
  const otherFarmer=role!=='landlord'?[PLAYER,LEFT,RIGHT].find(p=>p!==who&&p!==G.landlord):-1;
  const partnerPlay=role!=='landlord'&&lp===partner;
  const dangerousLandlord=landlordCount<=3;
  if(role==='landlord'){
    const freq=aiCountRanks(hand),normal=candidates.filter(x=>x.pattern.type!=='BOMB'&&x.pattern.type!=='ROCKET'&&x.pattern.main<=14&&aiSplitPenalty(x.cards,freq)<25);
    const threat=Math.min(G.hands[LEFT].length,G.hands[RIGHT].length);
    if(!normal.length&&threat>3)return true;
    return false;
  }
  const canFinishAll=candidates.some(x=>x.cards.length===hand.length);
  const hasMid=candidates.some(x=>x.pattern.type!=='BOMB'&&x.pattern.type!=='ROCKET'&&x.cards.every(c=>c.rank>=13&&c.rank<=14));
  const freq=aiCountRanks(hand);
  const isBig=x=>x.pattern.type==='BOMB'||x.pattern.type==='ROCKET'||x.cards.some(c=>c.rank>=15);
  const canUseMid=candidates.some(x=>!isBig(x));
  const allTop=candidates.every(x=>isBig(x));
  // Lv1: can finish all in one play
  if(canFinishAll)return false;
  // Lv1.5: 放水送队友——地主出小牌、我是地主下家(farmerNext)、队友(我的下家)剩≤2张且大概率能接 → 让牌放水，
  // 让牌权自然轮给队友接走出完（逆时针 0→2→1→0 固定：地主出牌→我→队友→地主，放水队友必轮到）。
  // 放水=送队友直接赢，优先于 Lv2 死压（队友接住就赢，比压牌更优）。
  if(lp===G.landlord&&role==='farmerNext'&&partnerCount<=2){
    if(partnerCount===1&&last.type==='SINGLE'){
      // 队友1张只能接单：用记牌器算队友手里 >last.main 的单牌期望，大概率能接才放
      let catchP=0;
      for(let r=last.main+1;r<=17;r++)catchP+=aiEstimateCountIn(partner,r);
      if(catchP>=0.8)return true;
    }else if(partnerCount===2&&last.type==='SINGLE'&&last.main<=8){
      // 队友2张只放单牌（两张单接单牌大概率能接）；对子不放——队友2张可能是两张单牌，接不住对子
      return true;
    }
  }
  // Lv2: landlord <=2 cards
  if(lp===G.landlord&&landlordCount<=2)return false;
  // Lv3: partner <=1 card
  if(partnerPlay&&partnerCount<=1)return true;
  // Lv3.4: 上家接力——队友(下家)出的牌太小(≤8)、地主牌还多(>5)、队友牌也多(>4张)时，
  // 上家(最后防线)用最小能压的牌接力抬价，防止地主用小牌轻松接走队友的小牌（两个农民轮流抬价）
  if(partnerPlay&&role==='farmerPrev'&&last.main<=8&&landlordCount>5&&partnerCount>4&&!canFinishAll)return false;
  // Lv3.5: 队友出牌且地主牌还多(>5张) → 让队友继续出，不抢牌权（通用配合规则）
  if(partnerPlay&&!canFinishAll&&landlordCount>5)return true;
  // Lv3.6: 队友快出完(≤4张)且地主未到危险线(>3张) → 绝不让队友失去牌权
  if(partnerPlay&&!canFinishAll&&partnerCount<=4&&landlordCount>3)return true;
  // Lv4: farmerNext and landlord <=8（地主进入收尾危险区，下家必须顶，阻止地主清牌）
  if(lp===G.landlord&&role==='farmerNext'&&landlordCount<=8)return false;
  // Lv4.5: farmerNext raise price when landlord plays big cards
  if(lp===G.landlord&&role==='farmerNext'){
    if(last.main>=13){
      const hasCounter=candidates.some(x=>x.pattern.type!=='BOMB'&&x.pattern.type!=='ROCKET'&&x.pattern.main>last.main);
      if(hasCounter)return false;
    }
  }
  // Lv5: farmerPrev and landlord <=5（上家是最后防线：地主≤5张必须死顶）
  if(lp===G.landlord&&role==='farmerPrev'&&landlordCount<=5)return false;
  // Lv5.5: farmerPrev must block landlord (flexible if hand is strong) ——地主≤8张时手牌中等(≤65)也强制顶
  if(lp===G.landlord&&role==='farmerPrev'){
    const myHandStrength=evaluateHand(hand).score;
    if(landlordCount<=8?myHandStrength<=65:myHandStrength<=55){
      const hasNormal=candidates.some(x=>x.pattern.type!=='BOMB'&&x.pattern.type!=='ROCKET');
      if(hasNormal)return false;
    }
  }
  // Lv6: partner played big card, mid cards available
  if(partnerPlay&&last.main>=13){
    if(canUseMid)return false;
    if(allTop)return true;
  }
  // Lv7: partner close to finish, only top cards
  if(partnerPlay&&partnerCount<=6&&landlordCount>5&&allTop)return true;
  // bomb takeover
  if(partnerPlay&&last.type!=='BOMB'&&last.type!=='ROCKET'){
    const bombCands=candidates.filter(x=>x.pattern.type==='BOMB'||x.pattern.type==='ROCKET');
    const winAfterBomb=bombCands.some(x=>(hand.length-x.cards.length)<=3);
    const partnerCanWin=partnerCount<=2&&last.main<=12;
    if(winAfterBomb&&!partnerCanWin&&landlordCount<=5)return false;
  }
  // Hard rule: never bomb partner unless can finish immediately
  if(partnerPlay){
    const hasBomb=candidates.some(x=>x.pattern.type==='BOMB'||x.pattern.type==='ROCKET');
    if(hasBomb){
      const bombFinish=candidates.some(x=>(x.pattern.type==='BOMB'||x.pattern.type==='ROCKET')&&(hand.length-x.cards.length)<=1);
      if(!bombFinish)return true;
    }
  }
  // Lv8: card counter suggests cheap cards in partner（升级点五：改用 aiEstimateCountIn 概率推算）
  if(lp===G.landlord&&!dangerousLandlord&&landlordCount>5&&otherFarmer>=0&&AI_MEMORY.passStreak[otherFarmer]===0){
    const cheap=candidates.some(x=>x.pattern.type!=='BOMB'&&x.pattern.type!=='ROCKET'&&x.pattern.main<14);
    if(!cheap){
      const partnerH=partner>=0?(G.hands[partner]||[]).length:0;
      const landlordH=landlordCount;
      if(partnerH>=landlordH){
        let cheaperInPartner=false;
        if(last.type==='SINGLE'){for(let r=last.main+1;r<=14;r++){if(aiEstimateCountIn(partner,r)>=0.8){cheaperInPartner=true;break;}}}
        else if(last.type==='PAIR'){for(let r=last.main+1;r<=14;r++){if(aiEstimateCountIn(partner,r)>=1.5){cheaperInPartner=true;break;}}}
        else if(last.type==='TRIPLE'||last.type==='TRIPLE_ONE'||last.type==='TRIPLE_TWO'){for(let r=last.main+1;r<=14;r++){if(aiEstimateCountIn(partner,r)>=2.2){cheaperInPartner=true;break;}}}
        if(cheaperInPartner)return true;
      }
    }
  }
  // Special: both partner and landlord close to finish
  if(partnerPlay&&partnerCount<=3&&landlordCount<=3)return false;
  // 下家面对地主出的牌：有便宜牌(<10)就顶；只能拿≥10的中牌压时，让给上家(最后防线)顶——
  // 两个农民轮流顶地主，避免"下家顶太狠、上家整局看戏"；地主快出完(≤5张)时下家仍必须顶（Lv4）
  if(role==='farmerNext'&&lp===G.landlord&&landlordCount>5&&otherFarmer>=0){
    const cheap=candidates.some(x=>x.pattern.type!=='BOMB'&&x.pattern.type!=='ROCKET'&&x.pattern.main<10);
    if(!cheap)return true;
  }
  // farmerNext take back when partner led medium cards and landlord passed
  if(role==='farmerNext'&&lp===partner&&AI_MEMORY.passStreak[G.landlord]>0){
    if(last.main>=7&&last.main<=11){
      const hasMid=candidates.some(x=>x.pattern.type!=='BOMB'&&x.pattern.type!=='ROCKET'&&x.pattern.main>=7&&x.pattern.main<=11);
      if(hasMid)return false;
    }
  }
  // Default: play normally
  return false;
}

function aiPickScored(scored){
  if(!scored.length)return null;
  scored.sort((a,b)=>b.score-a.score||b.x.cards.length-a.x.cards.length);
  const topN=scored.slice(0,5);
  const rem=(function(){try{return aiRemainingMap();}catch(e){return{};}})();
  for(let i=0;i<topN.length;i++){
    try{
      const v=topN[i],after=G.hands[G.current].filter(c=>!v.x.cards.some(y=>y.id===c.id));
      if(!after.length){v.score+=60;continue;}
      let bonus=0;
      // Step 2
      const c2=aiCandidates(after);
      if(!c2.length)continue;
      const s2=c2.map(x=>({x,score:aiCandidateScore(x,after,G.current,'lead-lookahead',null)}));
      s2.sort((a,b)=>b.score-a.score);
      const best2=s2[0];
      if(!best2)continue;
      const safe2=Object.keys(rem).every(r=>{const n=rem[r]||0;return n<=0||!best2.x.cards.some(c=>String(c.rank)===r);});
      const after2=after.filter(c=>!best2.x.cards.some(y=>y.id===c.id));
      if(!after2.length){bonus+=50+(safe2?5:0);}
      else{
        bonus+=30;
        // Step 3
        const c3=aiCandidates(after2);
        if(c3.length){
          const s3=c3.map(x=>({x,score:aiCandidateScore(x,after2,G.current,'lead-lookahead',null)}));
          s3.sort((a,b)=>b.score-a.score);
          const best3=s3[0];
          if(best3){
            const after3=after2.filter(c=>!best3.x.cards.some(y=>y.id===c.id));
            if(!after3.length){bonus+=20;}
            else{bonus+=10;}
          }
        }
      }
      // Penalty for risky plays
      const maxRank=Math.max(...v.x.cards.map(c=>c.rank));
      if(maxRank>=15&&v.x.pattern.type!=='BOMB'&&v.x.pattern.type!=='ROCKET'){
        const jokerOut=(rem[16]||0)+(rem[17]||0);
        if(jokerOut>0)bonus-=8;
      }
      v.score+=bonus;
    }catch(e){}
  }
  topN.sort((a,b)=>b.score-a.score||b.x.cards.length-a.x.cards.length);
  const top=topN[0].score,near=topN.filter(v=>v.score>=top-1);
  return near[Math.floor(Math.random()*near.length)].x.cards;
}

function aiFindCounter(hand,last,who,strategy){aiObservePlay();const allCands=aiCandidates(hand).filter(x=>aiCanBeat(x,last));if(!allCands.length)return null;if(aiShouldPassCounter(hand,last,who,allCands))return null;const sameType=allCands.filter(x=>x.pattern.type===last.type&&x.pattern.len===last.len);let candidates=allCands;if(sameType.length>=1){const minMain=Math.min(...sameType.map(c=>c.pattern.main));candidates=sameType.filter(c=>c.pattern.main===minMain);}return aiPickScored(candidates.map(x=>({x,score:aiCandidateScore(x,hand,who,'counter',last)})));}
function aiLead(hand,who,strategy){aiObservePlay();const candidates=aiCandidates(hand);if(!candidates.length)return hand.slice(0,1);const rem=(function(){try{return aiRemainingMap();}catch(e){return{};}})();return aiPickScored(candidates.map(x=>({x,score:aiCandidateScore(x,hand,who,'lead-'+strategy,null)})))||hand.slice(0,1);}



// ===== 出牌入口 v3 =====
function aiPlay(hand,lastPattern){
  const who=G.current,role=aiRole(who),teammate=aiPartner(who);
  const teammateCount=teammate>=0?(G.hands[teammate]||[]).length:99;
  const landlordCount=aiLandlordCount();
  const _ehScore=evaluateHand(hand).score;
  const strategy=hand.length<=5?'aggressive':(_ehScore>60&&hand.length<=8?'aggressive':(role!=='landlord'&&teammateCount<=4?'support':(_ehScore<35&&hand.length>8?'defensive':(landlordCount<=4?(role==='landlord'?'aggressive':'defensive'):(_ehScore<40&&hand.length>10?'defensive':'balanced')))));
  if(!lastPattern)return aiLead(hand,who,strategy);
  return aiFindCounter(hand,lastPattern,who,strategy);
}

// ===== 工具函数（hint 依赖，勿删） =====
function aiConsecutiveRuns(ranks,minLen){
  const out=[],a=[...new Set(ranks)].filter(r=>r<=14).sort((x,y)=>x-y);
  let run=[];
  for(const r of a){if(!run.length||r===run[run.length-1]+1)run.push(r);else{if(run.length>=minLen)out.push([...run]);run=[r];}}
  if(run.length>=minLen)out.push([...run]);
  return out;
}
function aiNext(who){return(who+2)%3;}
function aiRole(who){
  if(who===G.landlord)return'landlord';
  return who===aiNext(G.landlord)?'farmerNext':'farmerPrev';
}
function aiPartner(who){return aiRole(who)==='landlord'?-1:[PLAYER,LEFT,RIGHT].find(p=>p!==who&&p!==G.landlord);}
function aiLandlordCount(){return G.landlord>=0?(G.hands[G.landlord]||[]).length:99;}
function aiThreatCount(who){return aiRole(who)==='landlord'?Math.min(G.hands[LEFT].length,G.hands[RIGHT].length):aiLandlordCount();}
function findSmallestBeating(hand,last){return aiFindSameType(hand,last)[0]?.cards||null;}
function findBomb(hand){return aiBombs(hand)[0]?.cards||null;}
function findAllBeatingPlays(hand,last){return aiCandidates(hand).filter(x=>aiCanBeat(x,last)).map(x=>x.cards);}
function findAllLeadingPlays(hand){return aiCandidates(hand).map(x=>x.cards);}


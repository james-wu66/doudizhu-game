        <input type="password" class="login-input" id="input-password" placeholder="请输入密码（至少4位）" maxlength="20" autocomplete="off">
        <button type="button" class="toggle-pwd" onclick="togglePwd('input-password',this)">👁️</button>
      </div>
      <div class="password-wrapper" id="confirm-password-group" style="display:none">
        <input type="password" class="login-input" id="input-confirm-password" placeholder="请确认密码" maxlength="20" autocomplete="off">
        <button type="button" class="toggle-pwd" onclick="togglePwd('input-confirm-password',this)">👁️</button>
      </div>
      <label class="login-remember">
        <input type="checkbox" id="remember-login" checked>
        <span>记住密码（下次打开自动填好账号，点登录即可）</span>
      </label>

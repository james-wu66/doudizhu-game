  if(pattern.type==='STRAIGHT'||pattern.type==='STRAIGHT_PAIR'||pattern.type.startsWith('AIRPLANE'))score+=12;
  if(pattern.type==='FOUR_TWO')score+=10;
  if(pattern.type==='FOUR_TWO'&&freq[pattern.main]===4&&after.length>0)score-=30; // 整副炸弹不当四带二主牌（清空手牌除外）

      if(pattern.type==='SINGLE'&&pattern.main<=10)score+=8;
    }
    if(partnerPlay){score-=partnerCount<=2?70:partnerCount<=4?35:8;if(landlordCount<=3)score+=90;else if(landlordCount<=6)score+=42;if(pattern.type!=='BOMB'&&pattern.type!=='ROCKET'){const maxRank=Math.max(...x.cards.map(c=>c.rank));if(maxRank>=13)score-=30;if(maxRank>=15)score-=20;}}
    if(after.length===0)score+=140;

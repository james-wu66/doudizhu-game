}
function aiCandidateScore(x,hand,who,mode,last){
  const role=aiRole(who),pattern=x.pattern,after=hand.filter(c=>!x.cards.some(y=>y.id===c.id));
  const shape=aiHandShape(after),landlordCount=aiLandlordCount(),partner=aiPartner(who),partnerCount=partner>=0?(G.hands[partner]||[]).length:99;
  const lastPlayer=lastPlayerForAI(),freq=aiCountRanks(hand),big=aiBigCardsStatus();
  // === Core 1: base score ===

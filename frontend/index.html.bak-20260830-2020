    if(last&&last.type==='BOMB'&&x.pattern.type==='BOMB')return 100;return -80;
  }
  if(mode==='counter'&&role!=='landlord'&&lastPlayer===partner)return partnerCount<=3?-90:-25;
  if(mode==='counter'&&role==='landlord'){
    const threat=Math.min(G.hands[LEFT].length,G.hands[RIGHT].length);
    if(threat<=3)return 120;if(last&&last.type==='BOMB')return 100;return -80;
  }
  if(role!=='landlord'&&landlordCount<=3)return 120;
  if(hand.length<=6)return 70;return -70;
}
function aiControlTradeoff(x,hand,who,last,mode){
  if(mode!=='counter'||!last)return 0;
  const role=aiRole(who),lp=lastPlayerForAI(),freq=aiCountRanks(hand);
  if(role==='landlord'||lp!==G.landlord||last.type!=='SINGLE'||(last.main!==13&&last.main!==14))return 0;
  const landlordCount=aiLandlordCount(),hasPairTwo=(freq[15]||0)>=2,hasJoker=(freq[16]||0)>0||(freq[17]||0)>0;

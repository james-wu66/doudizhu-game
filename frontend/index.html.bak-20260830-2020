}

function lastPlayerForAI(){return G.lastPlay?G.lastPlay.player:-1;}
// ===== 升级点一：手数分析（开源精华） =====
// 估算一手牌"要打几手才能出完"：贪心保留结构（王炸→炸弹→三根/飞机→连对→顺子→对子→单牌），
// 不鼓励拆牌（拆牌罚分另算）
function estimateHands(cards){
  if(!cards||!cards.length)return 0;
  const freq=aiCountRanks(cards);
  let hands=0;
  if(freq[16]&&freq[17]){hands++;freq[16]=0;freq[17]=0;}
  for(const r in freq){if(freq[r]===4){hands++;freq[r]=0;}}
  const triples=Object.keys(freq).map(Number).filter(r=>freq[r]>=3&&r<=14).sort((a,b)=>a-b);
  let tripleGroups=0,t=0;
  while(t<triples.length){
    let j=t;
    while(j+1<triples.length&&triples[j+1]===triples[j]+1)j++;
    tripleGroups++;
    for(let k=t;k<=j;k++)freq[triples[k]]-=3;
    t=j+1;
  }
  hands+=tripleGroups;
  const pairs=Object.keys(freq).map(Number).filter(r=>freq[r]>=2&&r<=14).sort((a,b)=>a-b);
  let p=0;
  while(p<pairs.length){
    let j=p;
    while(j+1<pairs.length&&pairs[j+1]===pairs[j]+1)j++;
    if(j-p+1>=3){hands++;for(let k=p;k<=j;k++)freq[pairs[k]]-=2;}
    p=j+1;
  }
  const singles=Object.keys(freq).map(Number).filter(r=>freq[r]>0&&r<=14).sort((a,b)=>a-b);
  let s=0;
  while(s<singles.length){
    let j=s;
    while(j+1<singles.length&&singles[j+1]===singles[j]+1)j++;
    if(j-s+1>=5){hands++;for(let k=s;k<=j;k++)freq[singles[k]]--;}
    s=j+1;
  }
  let singleCount=0,pairCount=0;
  for(const r in freq){
    const n=freq[r];
    pairCount+=Math.floor(n/2);
    singleCount+=n%2;
  }
  // 三带/飞机带翅膀：每手三根可带走1个散单或1个对子（不增加手数）
  let carry=tripleGroups;
  const carrySingles=Math.min(singleCount,carry);
  singleCount-=carrySingles;carry-=carrySingles;
  const carryPairs=Math.min(pairCount,carry);
  pairCount-=carryPairs;
  hands+=singleCount+pairCount;
  return hands;
}
function aiRouteValue(hand,candidate,who){
  const after=hand.filter(c=>!candidate.cards.some(x=>x.id===c.id));if(!after.length)return 180;
  const next=aiCandidates(after);if(!next.length)return -80;
  const shape=aiHandShape(after);let value=-shape.groups*7-shape.singles*3;
  if(next.some(x=>x.cards.length===after.length))value+=90;
  value+=Math.max(...next.map(x=>x.cards.length),0)*4;
  // 升级点一：手数分析（辅助分，封顶，不压过拆牌/控制牌罚分）——剩余手数越少越好
  const hands=estimateHands(after);
  value+=(5-Math.min(5,hands))*5;
  const partner=aiPartner(who),pref=partner>=0?AI_MEMORY.patterns[partner]:{};
  if(pref[candidate.pattern.type])value+=Math.min(18,pref[candidate.pattern.type]*3);
  return value;
}
function aiBombValue(x,hand,who,last,mode){
  if(x.pattern.type!=='BOMB'&&x.pattern.type!=='ROCKET')return 0;
  const role=aiRole(who),after=hand.filter(c=>!x.cards.some(y=>y.id===c.id)),landlordCount=aiLandlordCount();
  const partner=aiPartner(who),partnerCount=partner>=0?(G.hands[partner]||[]).length:99,lastPlayer=lastPlayerForAI();
  if(after.length===0)return 180;
